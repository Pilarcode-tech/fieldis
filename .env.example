# ============================================
# Fieldis — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# Em produção, configure diretamente no painel do serviço
# (Vercel, Railway, etc.)

# Banco de dados (Neon em produção — adicionar ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fieldis"

# Redis (Railway gera automaticamente em produção)
REDIS_URL="redis://localhost:6379"

# JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET="seu-jwt-secret-aqui-minimo-32-caracteres"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# API (Railway injeta PORT automaticamente em produção)
API_PORT=3001
API_HOST=0.0.0.0
FRONTEND_URL="http://localhost:3000"
LOG_LEVEL="info"

# NextAuth (configurar no Vercel)
NEXTAUTH_SECRET="seu-nextauth-secret-aqui-minimo-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Frontend → API
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
API_URL="http://localhost:3001/api/v1"

# Asaas (gateway de pagamento)
ASAAS_API_KEY=""
ASAAS_ENVIRONMENT="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# Resend (envio de email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Fieldis <noreply@fieldis.com.br>"

# Cloudflare R2 (opcional — deixar vazio para usar disco local)
# Instalar @aws-sdk/client-s3 quando ativar R2
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
